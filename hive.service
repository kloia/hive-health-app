[Unit]
Description=HIVE stock service
After=network.target postgresql.service

[Service]
Type=simple
User=hive
WorkingDirectory=/opt/hive
ExecStart=/opt/hive/hive
Environment=DB_HOST=localhost
Environment=DB_PORT=5432
Environment=DB_USER=hive
Environment=DB_NAME=hive
Environment=PORT=8080
# DB_PASSWORD lives here (chmod 600, owned by root), not in this unit file.
EnvironmentFile=/etc/hive/hive.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
